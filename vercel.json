{
  "rewrites": [
    {
      "source": "/api-brevo/:path*",
      "destination": "https://api.brevo.com/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api-brevo|api|assets|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
